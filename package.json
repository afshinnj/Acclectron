{
  "name": "accletron",
  "productName": "Acclectron",
  "version": "1.0.2",
  "description": "نرم‌افزار حسابداری دسکتاپ فارسی برای مدیریت فروش، خرید، انبار و دریافت‌ها",
  "keywords": [
    "electron",
    "desktop",
    "accounting",
    "persian",
    "inventory",
    "point-of-sale"
  ],
  "license": "MIT",
  "author": "Afshin",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "check": "node --check main.js && node --check preload.js && node --check renderer.js && node --check src/main/database.js && node --check src/main/domain/sales.js",
    "test": "node --test --test-concurrency=1 test/database.test.js test/sales.test.js test/sales-reports.test.js",
    "build:portable": "powershell -ExecutionPolicy Bypass -File ./build-portable.ps1",
    "build:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/generate-win-icon.ps1 && electron-builder --win nsis",
    "release": "npm run check && npm test && npm run build:portable"
  },
  "build": {
    "appId": "ir.accletron.desktop",
    "productName": "Acclectron",
    "asar": true,
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "renderer.js",
      "styles.css",
      "assets/**/*",
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist/installer",
      "buildResources": "assets"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Acclectron-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Acclectron",
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "electron": "^41.2.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "yauzl": "^2.10.0"
  }
}
