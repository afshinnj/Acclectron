{
  "name": "accletron",
  "productName": "Acclectron",
  "version": "1.0.0",
  "description": "A starter Electron desktop application",
  "keywords": [
    "electron",
    "desktop"
  ],
  "license": "MIT",
  "author": "",
  "type": "commonjs",
  "main": "main.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "check": "node --check main.js && node --check preload.js && node --check renderer.js && node --check src/main/database.js && node --check src/main/domain/sales.js",
    "test": "node --test --test-concurrency=1 test/database.test.js test/sales.test.js",
    "build:portable": "powershell -ExecutionPolicy Bypass -File ./build-portable.ps1"
  },
  "devDependencies": {
    "electron": "^41.2.1"
  }
}
